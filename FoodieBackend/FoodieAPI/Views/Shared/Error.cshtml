@model ErrorViewModel
@{
    ViewData["Title"] = Model.Title;
    Layout = "/Areas/Admin/Views/Shared/_AuthLayout.cshtml";
}

<div class="card shadow-sm text-center">
    <div class="card-body p-4">
        <div class="display-4 fw-bold text-secondary">@Model.StatusCode</div>
        <h2 class="h5 mt-2">@Model.Title</h2>
        <p class="text-secondary">@Model.Message</p>
        @if (Model.TraceId is not null)
        {
            @* Chỉ hiện mã tra cứu, không bao giờ hiện chi tiết lỗi kỹ thuật cho người dùng *@
            <p class="small text-secondary">Mã tra cứu: <code>@Model.TraceId</code></p>
        }
        <a class="btn btn-primary" href="/Admin">Về trang quản trị</a>
    </div>
</div>
