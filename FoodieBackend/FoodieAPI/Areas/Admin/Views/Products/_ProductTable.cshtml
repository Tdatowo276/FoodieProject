@model ProductListViewModel

@if (Model.Result.Items.Count == 0)
{
    <div class="card card-body text-center text-secondary shadow-sm">Không có món nào phù hợp.</div>
    return;
}

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width:64px">Ảnh</th>
                    <th>Tên món</th>
                    <th class="d-none d-md-table-cell">Danh mục</th>
                    <th class="text-end">Giá</th>
                    <th class="text-end" style="width:120px">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model.Result.Items)
                {
                    <tr>
                        <td>
                            @if (p.ImageUrl is not null)
                            {
                                <img src="@p.ImageUrl" alt="" class="rounded object-fit-cover" width="48" height="48" loading="lazy" />
                            }
                            else
                            {
                                <div class="rounded bg-body-secondary d-flex align-items-center justify-content-center text-secondary"
                                     style="width:48px;height:48px"><i class="bi bi-image"></i></div>
                            }
                        </td>
                        <td>
                            <div class="fw-medium">
                                @p.Name
                                @if (p.IsFeatured) { <i class="bi bi-star-fill text-warning small" title="Món nổi bật"></i> }
                            </div>
                            <div class="small text-secondary d-md-none">@p.Category</div>
                        </td>
                        <td class="d-none d-md-table-cell">@p.Category</td>
                        <td class="text-end text-nowrap">@AdminFormat.Money(p.Price)</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@p.Id" title="Sửa" aria-label="Sửa @p.Name">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <form asp-action="Delete" asp-route-id="@p.Id" method="post" class="d-inline"
                                  data-confirm="Xóa món &quot;@p.Name&quot;? Thao tác này không thể hoàn tác.">
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa" aria-label="Xóa @p.Name">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<partial name="_Pager" model="Model.Pager" />
