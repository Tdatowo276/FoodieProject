@model ReviewListViewModel
@{
    ViewData["Title"] = "Đánh giá";
}

<h1 class="h3 mb-3">Đánh giá món ăn</h1>

<form method="get" asp-action="Index" class="card card-body shadow-sm mb-3" data-ajax-filter="#review-list" role="search">
    <div class="row g-2">
        <div class="col-12 col-md-6">
            <input type="search" name="keyword" value="@Model.Query.Keyword" class="form-control"
                   placeholder="Tên món, người đánh giá hoặc nội dung…" aria-label="Từ khóa" maxlength="100" />
        </div>
        <div class="col-8 col-md-4">
            <select name="rating" class="form-select" aria-label="Số sao">
                <option value="">Tất cả số sao</option>
                @for (var s = 5; s >= 1; s--)
                {
                    <option value="@s" selected="@(Model.Query.Rating == s)">@s sao</option>
                }
            </select>
        </div>
        <div class="col-4 col-md-2 d-grid">
            <button type="submit" class="btn btn-outline-secondary"><i class="bi bi-funnel me-1"></i>Lọc</button>
        </div>
    </div>
</form>

<div id="review-list" aria-live="polite">
    <partial name="_ReviewTable" model="Model" />
</div>
