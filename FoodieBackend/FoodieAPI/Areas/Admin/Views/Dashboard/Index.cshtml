@model DashboardViewModel
@{
    ViewData["Title"] = "Tổng quan";
    var s = Model.Stats;
    var cards = new[]
    {
        (Title: "Doanh thu tháng này", Value: AdminFormat.Money(s.Revenue.Value), Growth: s.Revenue.Growth, Icon: "bi-cash-coin", Color: "success"),
        (Title: "Đơn hàng tháng này", Value: s.Orders.Value.ToString("N0"), Growth: s.Orders.Growth, Icon: "bi-receipt", Color: "primary"),
        (Title: "Khách hàng", Value: s.Customers.Value.ToString("N0"), Growth: s.Customers.Growth, Icon: "bi-people", Color: "warning"),
    };
}

<h1 class="h3 mb-4">Tổng quan</h1>

<div class="row g-3 mb-4">
    @foreach (var c in cards)
    {
        <div class="col-12 col-sm-6 col-xl-4">
            <div class="card shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="fs-2 text-@c.Color"><i class="bi @c.Icon"></i></div>
                    <div class="min-w-0">
                        <div class="text-secondary small">@c.Title</div>
                        <div class="fs-4 fw-semibold text-truncate">@c.Value</div>
                        <div class="small @(c.Growth >= 0 ? "text-success" : "text-danger")">
                            <i class="bi @(c.Growth >= 0 ? "bi-arrow-up" : "bi-arrow-down")"></i>
                            @Math.Abs(c.Growth)% so với tháng trước
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
<p class="small text-secondary">Doanh thu chỉ tính các đơn đã hoàn thành; số đơn không tính đơn đã hủy.</p>

@* Món bán chạy 30 ngày qua: thanh ngang tỉ lệ theo số phần bán được *@
<div class="card shadow-sm mb-4">
    <div class="card-header bg-body">Món bán chạy <span class="text-secondary small">· 30 ngày qua, đơn đã hoàn thành</span></div>
    @if (Model.TopProducts.Count == 0)
    {
        <div class="card-body text-secondary">Chưa có đơn hoàn thành nào trong 30 ngày qua.</div>
    }
    else
    {
        var maxQty = Model.TopProducts.Max(t => t.Quantity);
        <ol class="list-group list-group-flush list-group-numbered">
            @foreach (var t in Model.TopProducts)
            {
                var percent = (int)Math.Round(t.Quantity * 100.0 / maxQty);
                <li class="list-group-item d-flex align-items-center gap-3">
                    <div class="flex-grow-1 min-w-0">
                        <div class="d-flex justify-content-between gap-2">
                            <span class="fw-medium text-truncate">@t.Name</span>
                            <span class="text-nowrap small">@t.Quantity phần · @AdminFormat.Money(t.Revenue)</span>
                        </div>
                        <div class="progress mt-1" role="progressbar" aria-label="@t.Name: @t.Quantity phần"
                             aria-valuenow="@t.Quantity" aria-valuemin="0" aria-valuemax="@maxQty" style="height: 6px">
                            <div class="progress-bar bg-danger" style="width: @percent%"></div>
                        </div>
                    </div>
                </li>
            }
        </ol>
    }
</div>

<div class="card shadow-sm">
    <div class="card-header bg-body d-flex justify-content-between align-items-center">
        <span>Đơn chờ xác nhận <span class="badge text-bg-warning">@Model.PendingTotal</span></span>
        <a class="small" asp-controller="Orders" asp-action="Index" asp-route-status="@OrderStatuses.Pending">Xem tất cả</a>
    </div>
    @if (Model.PendingOrders.Count == 0)
    {
        <div class="card-body text-secondary">Không có đơn nào đang chờ. 🎉</div>
    }
    else
    {
        <div class="list-group list-group-flush">
            @foreach (var o in Model.PendingOrders)
            {
                <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center gap-2"
                   asp-controller="Orders" asp-action="Details" asp-route-id="@o.Code">
                    <span class="min-w-0">
                        <span class="fw-medium">@o.Code</span> · @o.Customer
                        <span class="d-block small text-secondary">@AdminFormat.VnTime(o.CreatedAt)</span>
                    </span>
                    <span class="text-nowrap">@AdminFormat.Money(o.Total)</span>
                </a>
            }
        </div>
    }
</div>
