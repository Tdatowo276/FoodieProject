@model StatsDto
@{
    ViewData["Title"] = "Tổng quan";
    var cards = new[]
    {
        (Title: "Doanh thu tháng này", Value: Model.Revenue.Value.ToString("N0") + "đ", Growth: Model.Revenue.Growth, Icon: "bi-cash-coin", Color: "success"),
        (Title: "Đơn hàng tháng này", Value: Model.Orders.Value.ToString("N0"), Growth: Model.Orders.Growth, Icon: "bi-receipt", Color: "primary"),
        (Title: "Khách hàng", Value: Model.Customers.Value.ToString("N0"), Growth: Model.Customers.Growth, Icon: "bi-people", Color: "warning"),
    };
}

<h1 class="h3 mb-4">Tổng quan</h1>

<div class="row g-3">
    @foreach (var c in cards)
    {
        <div class="col-12 col-sm-6 col-xl-4">
            <div class="card shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="fs-2 text-@c.Color"><i class="bi @c.Icon"></i></div>
                    <div class="min-w-0">
                        <div class="text-secondary small">@c.Title</div>
                        <div class="fs-4 fw-semibold text-truncate">@c.Value</div>
                        <div class="small @(c.Growth >= 0 ? "text-success" : "text-danger")">
                            <i class="bi @(c.Growth >= 0 ? "bi-arrow-up" : "bi-arrow-down")"></i>
                            @Math.Abs(c.Growth)% so với tháng trước
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
