@model List<CategoryDto>
@{
    ViewData["Title"] = "Danh mục";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">Danh mục</h1>
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg me-1"></i>Thêm danh mục</a>
</div>

@if (Model.Count == 0)
{
    <div class="card card-body text-center text-secondary shadow-sm">Chưa có danh mục nào.</div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Tên danh mục</th>
                        <th class="d-none d-md-table-cell">Mô tả</th>
                        <th class="text-center">Số món</th>
                        <th>Trạng thái</th>
                        <th class="text-end" style="width:120px">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td class="fw-medium">@c.Name</td>
                            <td class="d-none d-md-table-cell text-secondary small">@c.Description</td>
                            <td class="text-center">
                                <a asp-controller="Products" asp-action="Index" asp-route-categoryId="@c.Id">@c.ProductCount</a>
                            </td>
                            <td>
                                @if (c.IsActive)
                                {
                                    <span class="badge text-bg-success">Đang hiển thị</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-secondary">Đang ẩn</span>
                                }
                            </td>
                            <td class="text-end text-nowrap">
                                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@c.Id" title="Sửa" aria-label="Sửa @c.Name">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline"
                                      data-confirm="Xóa danh mục &quot;@c.Name&quot;?">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa" aria-label="Xóa @c.Name"
                                            disabled="@(c.ProductCount > 0)">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <p class="small text-secondary mt-2">
        <i class="bi bi-info-circle me-1"></i>Danh mục còn món thì không xóa được; hãy chuyển món sang danh mục khác hoặc ẩn danh mục.
    </p>
}
