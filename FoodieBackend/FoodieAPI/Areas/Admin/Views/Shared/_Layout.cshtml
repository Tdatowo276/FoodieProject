@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    string Active(string name) => string.Equals(controller, name, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    @* Token chống CSRF cho các request AJAX (gửi qua header X-CSRF-TOKEN, xem admin.js) *@
    <meta name="csrf-token" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />
    <title>@(ViewData["Title"] ?? "Quản trị") · Foodie Admin</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/admin/admin.css" asp-append-version="true" />
</head>
<body class="bg-body-tertiary">
    @* Thanh trên cùng: chỉ hiện trên màn hình nhỏ, có nút mở menu *@
    <nav class="navbar bg-dark navbar-dark d-lg-none sticky-top">
        <div class="container-fluid">
            <button class="btn btn-outline-light" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebar"
                    aria-controls="sidebar" aria-label="Mở menu">
                <i class="bi bi-list"></i>
            </button>
            <span class="navbar-brand mb-0 h1">🍔 Foodie Admin</span>
        </div>
    </nav>

    <div class="d-flex">
        @* Sidebar: cố định trên desktop, dạng offcanvas trượt ra trên điện thoại *@
        <aside id="sidebar" class="offcanvas-lg offcanvas-start text-bg-dark admin-sidebar" tabindex="-1" aria-label="Menu quản trị">
            <div class="offcanvas-header">
                <span class="fs-5 fw-semibold">🍔 Foodie Admin</span>
                <button type="button" class="btn-close btn-close-white d-lg-none" data-bs-dismiss="offcanvas"
                        data-bs-target="#sidebar" aria-label="Đóng"></button>
            </div>
            <div class="offcanvas-body d-flex flex-column p-3">
                <a class="d-none d-lg-block fs-5 fw-semibold text-white text-decoration-none mb-3" asp-controller="Dashboard" asp-action="Index">
                    🍔 Foodie Admin
                </a>
                <ul class="nav nav-pills flex-column mb-auto gap-1">
                    <li class="nav-item">
                        <a class="nav-link text-white @Active("Dashboard")" asp-controller="Dashboard" asp-action="Index">
                            <i class="bi bi-speedometer2 me-2"></i>Tổng quan
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white @Active("Orders")" asp-controller="Orders" asp-action="Index">
                            <i class="bi bi-receipt me-2"></i>Đơn hàng
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white @Active("Products")" asp-controller="Products" asp-action="Index">
                            <i class="bi bi-egg-fried me-2"></i>Món ăn
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white @Active("Categories")" asp-controller="Categories" asp-action="Index">
                            <i class="bi bi-tags me-2"></i>Danh mục
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white @Active("Users")" asp-controller="Users" asp-action="Index">
                            <i class="bi bi-people me-2"></i>Người dùng
                        </a>
                    </li>
                </ul>
                <hr />
                <div class="small text-white-50 mb-2">
                    <i class="bi bi-person-circle me-1"></i>@User.Identity?.Name
                </div>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="btn btn-outline-light btn-sm w-100">
                        <i class="bi bi-box-arrow-right me-1"></i>Đăng xuất
                    </button>
                </form>
            </div>
        </aside>

        <main class="flex-grow-1 p-3 p-md-4 admin-main">
            <partial name="_Alerts" />
            @RenderBody()
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/admin/admin.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
