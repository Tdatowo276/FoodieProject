@model PagerModel
@{
    if (Model.TotalPages <= 1) { return; }

    // Giữ nguyên bộ lọc hiện tại, chỉ thay số trang
    string Url(int page)
    {
        var values = new Dictionary<string, string?>(Model.RouteValues) { ["page"] = page.ToString() };
        return Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString(
            Context.Request.Path, values.Where(v => !string.IsNullOrEmpty(v.Value)));
    }

    // Hiện tối đa 5 số trang quanh trang hiện tại
    var from = Math.Max(1, Model.Page - 2);
    var to = Math.Min(Model.TotalPages, from + 4);
    from = Math.Max(1, to - 4);
}
<nav aria-label="Phân trang" class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-3">
    <span class="small text-secondary">Trang @Model.Page / @Model.TotalPages · @Model.Total kết quả</span>
    <ul class="pagination pagination-sm mb-0">
        <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
            <a class="page-link" href="@Url(Model.Page - 1)" data-page-link aria-label="Trang trước">&laquo;</a>
        </li>
        @for (var p = from; p <= to; p++)
        {
            <li class="page-item @(p == Model.Page ? "active" : "")">
                <a class="page-link" href="@Url(p)" data-page-link>@p</a>
            </li>
        }
        <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
            <a class="page-link" href="@Url(Model.Page + 1)" data-page-link aria-label="Trang sau">&raquo;</a>
        </li>
    </ul>
</nav>
