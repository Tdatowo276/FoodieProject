{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // KHÔNG đặt bí mật trong file này (file được commit lên Git).
  // Các giá trị bắt buộc sau phải cấu hình qua User Secrets (dev) hoặc biến môi trường (production):
  //   ConnectionStrings:Default   -> biến môi trường ConnectionStrings__Default
  //   Jwt:Key                     -> biến môi trường Jwt__Key  (tối thiểu 32 byte)
  //   Seed:AdminPassword          -> biến môi trường Seed__AdminPassword (tối thiểu 8 ký tự)
  // Xem README.MD, mục "Cấu hình bí mật".

  "Jwt": {
    "Issuer": "FoodieAPI",
    "Audience": "FoodieClient",
    "ExpiresMinutes": 60
  },
  "Seed": {
    "AdminEmail": "admin@foodie.vn"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173", "http://localhost:3000" ]
  }
}
